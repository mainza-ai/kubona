# D1: build context is platform/ (pyproject at root). Keep the bridge
# image free of state, secrets, tests, and the console tree; core/crates
# remain because the kubonad-specific ignore selects only what it needs.
__pycache__
.pytest_cache
.venv
*.egg-info
.env
.env.*
.git
tests
test_*.py
console
models
state
.kubona
*.db
*.db-lock
*.db-shm
*.db-wal
crates/*/target
