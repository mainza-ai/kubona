# Kubona Go Orchestrator (kubonad) — production image (D1).
#
# Multi-stage: builder compiles the static-ish binary (CGO stays ON:
# mattn/go-sqlite3 needs gcc; the amalgamation links statically so the
# final image needs no libsqlite3), final is debian-slim + nonroot.
# Go toolchain pinned to the CI lane (go.mod / ci.yml: 1.27.2 — patch bump
# for Trivy CRITICAL CVE-2026-56857, fixed in Go 1.27.2).
# Health: /api/health + /api/ready are public reads (no bearer), so the
# HEALTHCHECK needs no token. curl exists in final ONLY for that probe.
#
# Build (repo root):  docker build -f platform/docker/Dockerfile.kubonad -t kubona/kubonad:dev platform
# Run (compose is the supported path): see compose.prod.yml.
# The build context is platform/ (not platform/core) so the runtime can
# ship the shared contracts/ directory: the fidelity gate fails closed at
# boot without fidelity-devices.json, and the old core-only context could
# never contain it.

FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build

WORKDIR /src
COPY core/go.mod core/go.sum ./
RUN go mod download
COPY core/ .
# Shared contracts are runtime data (fidelity-devices.json, event types).
# Copying them into the image is what makes the production boot real.
COPY contracts ./contracts
# Trimpath for reproducible builds; CGO required (sqlite).
RUN CGO_ENABLED=1 go build -trimpath -o /kubonad ./cmd/kubonad

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

# upgrade -y: the Trivy image-scan gate fails on CRITICALs in this layer
# (libbrotli/perl CVEs observed 2026-10-28). The base digest stays pinned
# for reproducibility; upgrade applies the archive's security fixes on top
# at every build so a stale base cannot fail a fresh build.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 kubona && useradd -u 1000 -g kubona -m -s /bin/sh kubona

COPY --from=build /kubonad /usr/local/bin/kubonad
COPY --from=build /src/contracts /contracts
ENV KUBONA_CONTRACTS_DIR=/contracts

# Seed the state dir with daemon ownership: a fresh named volume inherits
# the image's directory (owner included); without this the volume mounts
# root-owned and the nonroot daemon cannot create its state (boot refuses,
# fail-closed — observed live before this line existed).
RUN mkdir -p /home/kubona/.kubona/models && chown -R kubona:kubona /home/kubona/.kubona
# Seed the bridge socket dir with daemon ownership (same volume-seeding
# pattern as above): kubonad joins the bridge's UDS as UID 1000, so the
# shared bridge-sock volume must not mount root-owned. The bridge seeds
# the same path in its own image; either side mounting first wins safely.
RUN mkdir -p /run/kubona && chown kubona:kubona /run/kubona

USER kubona
EXPOSE 8080
# State default is ~/.kubona/kubona.db — mount a volume there (compose does).
HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=15s \
    CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1

ENTRYPOINT ["/usr/local/bin/kubonad"]
# Loopback default is overridden here: the container port is published by
# compose, and TLS termination (if any) sits in front — see compose.prod.yml.
CMD ["--bind", "0.0.0.0", "--port", "8080"]
