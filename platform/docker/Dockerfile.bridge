# Kubona Python gRPC Bridge — production image (D1).
#
# Carries the compute stack (qiskit + chemistry extras, all == pinned in
# pyproject.toml — same discipline as CI). Slimming the chemistry deps
# out of this image is a follow-up, not this slice: the bridge imports
# them at module load (server.py), so omitting them is a crash, not a diet.
# Nonroot; HEALTHCHECK dials the UDS with plain grpc (no reflection
# needed — channel_ready only proves the socket accepts). Production
# transport is UDS-exclusive (no TCP socket exists): see compose.prod.yml.
#
# Build (repo root): docker build -f platform/docker/Dockerfile.bridge -t kubona/bridge:dev platform
# Run (compose is the supported path): see compose.prod.yml.

FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app
# Install first (better layer caching): project metadata + package, then
# the bridge tree. setuptools packages only kubona*; bridge/ runs as cwd.
COPY pyproject.toml ./
COPY kubona ./kubona
RUN pip install --no-cache-dir ".[qiskit,chemistry]" \
    && groupadd -g 1000 kubona && useradd -u 1000 -g kubona -m -s /bin/sh kubona

COPY bridge ./bridge
# T-01b: the closed event taxonomy is a runtime dependency, not just a
# test fixture — kubona.provenance refuses to import without it
# (fail-closed by design), and codesign_ops reaches it via
# kubona.codesign -> autoresearch -> provenance. The loader's designed
# override (KUBONA_EVENT_TYPES) points at the shipped copy.
COPY contracts ./contracts
# All closed registries are runtime dependencies of the installed package.
# The package resolves KUBONA_EVENT_TYPES / KUBONA_FIDELITY_DEVICES /
# KUBONA_ERROR_CATALOG by explicit path; without these an image can boot
# but its first quantum submit fails with FileNotFoundError.
ENV KUBONA_EVENT_TYPES=/app/contracts/event-types.json \
    KUBONA_FIDELITY_DEVICES=/app/contracts/fidelity-devices.json \
    KUBONA_ERROR_CATALOG=/app/contracts/error-catalog.csv
RUN chown -R kubona:kubona /app
# Seed the socket dir with daemon ownership: the shared bridge-sock volume
# inherits the image's directory (owner included); without this the volume
# mounts root-owned and the nonroot bridge cannot create its socket
# (same pattern as kubonad's state dir in Dockerfile.kubonad).
RUN mkdir -p /run/kubona && chown kubona:kubona /run/kubona

USER kubona
WORKDIR /app/bridge
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=30s \
    CMD python -c "import grpc; grpc.channel_ready_future(grpc.insecure_channel('unix:///run/kubona/bridge.sock')).result(timeout=4)"

CMD ["python", "server.py"]
