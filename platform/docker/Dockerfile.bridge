# Kubona Python gRPC Bridge — production image (D1).
#
# Carries the compute stack (qiskit + chemistry extras) from the committed
# uv.lock, the same resolved set CI uses. Slimming the chemistry deps
# out of this image is a follow-up, not this slice: the bridge imports
# them at module load (server.py), so omitting them is a crash, not a diet.
# Nonroot; HEALTHCHECK dials the UDS with plain grpc (no reflection
# needed — channel_ready only proves the socket accepts). Production
# transport is UDS-exclusive (no TCP socket exists): see compose.prod.yml.
#
# Build (repo root): docker build -f platform/docker/Dockerfile.bridge -t kubona/bridge:dev platform
# Run (compose is the supported path): see compose.prod.yml.

FROM rust:1-slim-bookworm AS qirbuild
WORKDIR /qir
COPY crates/qir-core ./crates/qir-core
RUN cargo build --release --locked --manifest-path crates/qir-core/Cargo.toml

FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

# glibc arena sprawl and BLAS thread pools size themselves from the node, not
# the container. Cap both to the 2-CPU / 4 GiB bridge budget; the Lean image
# already uses the same arena cap for the same reason.
ENV MALLOC_ARENA_MAX=2 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    NUMEXPR_NUM_THREADS=2

# uv is the resolver for the shipped Python environment; pin the binary by
# digest just like the base image. The lock is copied before source so the
# dependency layer survives kubona/ edits.
COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app
# Publication builds run in this compute plane: pdfTeX + the base font/bst
# packages are the real build path, and the API fails closed (build_unavailable)
# without them. The preamble uses amsmath/amssymb/graphicx and unsrt.bst only;
# keep the set minimal rather than pulling all of TeX Live.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       texlive-latex-base texlive-latex-recommended texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*
# Install first (better layer caching): lock + metadata, then the package,
# then the bridge tree. setuptools packages only kubona*; bridge/ runs as cwd.
# N5: g++/cmake/git are installed solely to build ARM64 C++ wheels (stim, pymatching)
# and purged in the same layer so no compiler or git ships in the runtime image.
COPY pyproject.toml uv.lock ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ cmake git \
    && uv sync --locked --no-install-project --extra qiskit --extra chemistry --extra qec \
    && apt-get purge -y --auto-remove g++ cmake git \
    && rm -rf /var/lib/apt/lists/*
COPY kubona ./kubona
RUN uv sync --locked --extra qiskit --extra chemistry --extra qec \
    && rm -f /bin/uv /bin/uvx \
    && groupadd -g 1000 kubona && useradd -u 1000 -g kubona -m -s /bin/sh kubona

COPY bridge ./bridge
# T-01b: the closed event taxonomy is a runtime dependency, not just a
# test fixture — kubona.provenance refuses to import without it
# (fail-closed by design), and codesign_ops reaches it via
# kubona.codesign -> autoresearch -> provenance. The loader's designed
# override (KUBONA_EVENT_TYPES) points at the shipped copy.
COPY contracts ./contracts
# All closed registries are runtime dependencies of the installed package.
# The package resolves KUBONA_EVENT_TYPES / KUBONA_FIDELITY_DEVICES /
# KUBONA_ERROR_CATALOG by explicit path; without these an image can boot
# but its first quantum submit fails with FileNotFoundError.
ENV KUBONA_EVENT_TYPES=/app/contracts/event-types.json \
    KUBONA_ERROR_CATALOG=/app/contracts/error-catalog.csv
RUN chown -R kubona:kubona /app
# Seed the socket dir with daemon ownership: the shared bridge-sock volume
# inherits the image's directory (owner included); without this the volume
# mounts root-owned and the nonroot bridge cannot create its socket
# (same pattern as kubonad's state dir in Dockerfile.kubonad).
# Keep the image state root free of nested seed content: bridge, preflight,
# and kubonad mount the same new volume concurrently, and Docker's volume
# copy-up can race on a nested directory ("models: file exists"). The
# entrypoint seeds the writable contract and model directories at runtime.
RUN mkdir -p /run/kubona /home/kubona/.kubona \
    && chown -R kubona:kubona /run/kubona /home/kubona/.kubona
COPY --from=qirbuild /qir/crates/qir-core/target/release/qir-core /usr/local/bin/qir-core
COPY docker/bridge-entrypoint.sh /usr/local/bin/bridge-entrypoint.sh
ENV KUBONA_QIR_CORE=/usr/local/bin/qir-core \
    KUBONA_QIR_ALLOWED_DIRS=/usr/local/bin
RUN chmod 0755 /usr/local/bin/bridge-entrypoint.sh

USER kubona
WORKDIR /app/bridge
HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=30s \
    CMD python -c "import grpc; grpc.channel_ready_future(grpc.insecure_channel('unix:///run/kubona/bridge.sock')).result(timeout=4)"

ENTRYPOINT ["/usr/local/bin/bridge-entrypoint.sh"]
