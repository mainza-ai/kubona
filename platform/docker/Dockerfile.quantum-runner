# Kubona Sovereign Quantum Runner Container (Tier B Workload Sandbox)
# Complies with NemoClaw / OpenClaw hardened security profile (openclaw.nvidia.com/v1)

FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

LABEL maintainer="Kubona Systems Maintainer <team@kubona.org>"
LABEL org.opencontainers.image.title="kubona-quantum-runner"
LABEL org.opencontainers.image.description="Hardened, unprivileged sandbox runner for autonomous quantum research"
LABEL org.opencontainers.image.version="1.1.0"

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install essential runtime libraries (BLAS/LAPACK for linear algebra)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

# Install the pinned quantum scientific stack (U0: == pins, never
# ranges — a range resolves untested combos on every rebuild. These pins
# are the versions measured from the shipped 1.1.0 image
# (docker run --entrypoint pip kubona-quantum-runner:1.1.0 freeze),
# all inside the old ranges; rebuild + import smoke re-verifies).
# Qiskit 1.3, Qiskit-Aer (statevector & noise), Qiskit-Algorithms (VQE), PennyLane, SciPy, NumPy
# qiskit-ibm-runtime (fake_provider backends for HumanEval evals — run locally,
# no credentials) + matplotlib (circuit-drawer test assertions). Added 2026-10-10
# for the code-execution harness (image 1.1.0).
RUN pip install --no-cache-dir \
    "numpy==2.0.2" \
    "scipy==1.14.1" \
    "qiskit==1.3.3" \
    "qiskit-aer==0.16.4" \
    "qiskit-algorithms==0.4.0" \
    "pennylane==0.45.1" \
    "qiskit-ibm-runtime==0.36.1" \
    "matplotlib==3.9.4"

# Create non-root unprivileged research sandbox user (UID 1000)
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/sh sandbox

# Prepare structured directory topology:
# /benchmark: read-only evaluation harnesses and Hamiltonian fixtures
# /workspace: isolated single mutable artifact directory
# /tmp: ephemeral scratch space
RUN mkdir -p /benchmark /workspace /tmp && \
    chown -R sandbox:sandbox /workspace /tmp && \
    chmod 755 /benchmark && \
    chmod 775 /workspace /tmp

USER sandbox:sandbox
WORKDIR /workspace

# Default entrypoint for script execution
ENTRYPOINT ["python3"]
CMD ["--version"]
