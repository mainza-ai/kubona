{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubona.dev/contracts/experiment-result-v1.schema.json",
  "title": "Kubona experiment result v1",
  "description": "Shared result envelope enforced at the Go job boundary. Variant fields (PES points, measurements, mitigation, optimizer trajectory) are additive; result_version, success and kind are always present.",
  "type": "object",
  "required": ["result_version", "success", "kind"],
  "properties": {
    "result_version": { "const": "experiment-result-v1" },
    "success": { "type": "boolean" },
    "kind": {
      "type": "string",
      "enum": [
        "vqe",
        "geometry_optimization",
        "vqe_repeats",
        "pes",
        "qaoa",
        "krylov",
        "mitigate",
        "vqe_hardware",
        "qaoa_hardware",
        "vqe_hardware_loop",
        "qaoa_hardware_loop",
        "hardware_pes",
        "excited_state",
        "reaction",
        "spin_chain",
        "spin_chain_hardware",
        "thermodynamic_limit",
        "lattice_dynamics",
        "conjecture"
      ]
    },
    "molecule": { "type": ["string", "null"] },
    "generic": { "type": "boolean" },
    "atom": { "type": "string" },
    "basis": { "type": "string" },
    "charge": { "type": "integer" },
    "spin": { "type": "integer" },
    "model": { "type": "string" },
    "rows": { "type": "integer", "minimum": 2, "maximum": 4 },
    "cols": { "type": "integer", "minimum": 2, "maximum": 4 },
    "optimized_bond_distance": { "type": "number" },
    "optimized_atom": { "type": "string" },
    "optimized_geometry": { "type": "array", "items": { "type": "object" } },
    "bond_lengths": { "type": "array", "items": { "type": "object" } },
    "geometry_relaxed": { "type": "boolean" },
    "relaxation": { "type": "object" },
    "finite_size": { "type": "array", "items": { "type": "object" } },
    "thermodynamic_limit": { "type": "object" },
    "bond_dim": { "type": "integer", "minimum": 4, "maximum": 64 },
    "sweeps": { "type": "integer", "minimum": 1, "maximum": 30 },
    "repeats": { "type": "integer", "minimum": 2, "maximum": 5 },
    "between_run_standard_error": { "type": "number" },
    "times": { "type": "array", "items": { "type": "object" } },
    "n_sites": { "type": "integer", "minimum": 2, "maximum": 14 },
    "coupling": { "type": "number" },
    "field": { "type": "number" },
    "periodic": { "type": "boolean" },
    "gap": { "type": ["number", "null"] },
    "gap_exact": { "type": ["number", "null"] },
    "below_exact": { "type": "boolean" },
    "below_fci": { "type": "boolean" },
    "ground_state_reached": { "type": "boolean" },
    "claimability_scope": { "type": "string" },
    "state_mode": { "type": "string", "enum": ["vqe", "exact"] },
    "observable_state": { "type": "string" },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "candidate_count": { "type": "integer" },
    "novelty_status": { "type": "string" },
    "novelty_note": { "type": "string" },
    "external_novelty": { "type": "object" },
    "bond_distance": { "type": ["number", "null"] },
    "reaction_energy": { "type": ["number", "null"] },
    "reaction_energy_exact": { "type": ["number", "null"] },
    "reaction_energy_exact_full": { "type": ["number", "null"] },
    "reactant_energy_exact_full": { "type": ["number", "null"] },
    "delta_full": { "type": ["number", "null"] },
    "method": { "type": "string" },
    "ansatz": { "type": "string" },
    "backend": { "type": "string" },
    "provider": { "type": "string" },
    "hardware": { "type": "boolean" },
    "measured": { "type": "boolean" },
    "simulated_optimizer": { "type": "boolean" },
    "energy": { "type": ["number", "null"] },
    "energy_measured": { "type": ["number", "null"] },
    "energy_exact": { "type": ["number", "null"] },
    "fci_exact_energy": { "type": ["number", "null"] },
    "active_space_fci_energy": { "type": ["number", "null"] },
    "uncertainty": { "type": ["number", "null"] },
    "ci95_mha": { "type": ["number", "null"] },
    "delta_mha": { "type": ["number", "null"] },
    "exact_delta_mha": { "type": ["number", "null"] },
    "shots": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "layers": { "type": "integer", "minimum": 1, "maximum": 8 },
    "pauli_coefficients": { "type": "object", "additionalProperties": { "type": "number" } },
    "pauli_label_convention": { "type": "string" },
    "theta": { "type": "array", "items": { "type": "number" } },
    "constant_energy": { "type": "number" },
    "claimable": { "type": "boolean" },
    "chemical_accuracy": { "type": "boolean" },
    "chemical_accuracy_limit_mha": { "type": "number" },
    "hardware_job_id": { "type": "string" },
    "hardware_job_ids": { "type": "array", "items": { "type": "string" } },
    "usage_seconds": { "type": ["number", "null"] },
    "actual_usd": { "type": ["number", "null"] },
    "trajectory": { "type": "array", "items": { "type": "object" } },
    "measurements": { "type": "object" },
    "points": { "type": "array", "items": { "type": "object" } },
    "mitigation": { "type": ["object", "null"] },
    "calibration_age_hours": { "type": ["number", "null"] },
    "calibration_fresh": { "type": ["boolean", "null"] },
    "calibration_checked_at": { "type": ["string", "null"] },
    "calibration_max_age_hours": { "type": "number" },
    "result_receipt": {
      "type": "object",
      "required": ["algorithm", "ledger_entry_hash", "result_sha256", "signed"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "ledger_entry_hash": { "type": "string" },
        "result_sha256": { "type": "string" },
        "signer_pubkey": { "type": "string" },
        "signature": { "type": "string" },
        "signed": { "type": "boolean" },
        "hash_version": { "type": "integer" },
        "signature_domain": { "type": "string" }
      }
    },
    "error_message": { "type": "string" }
  },
  "additionalProperties": true
}
