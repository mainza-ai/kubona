        "kind": "vqe",
        "molecule": "H2",
        "bond_distance": 0.7414,
        "layers": 1,
        "shots": 512,
        "seed": 3,
        "max_iterations": 5
      },
      "extract": "fci_exact_energy",
      "target": -1.1372701746609035,
      "tolerance": 0.0001,
      "budget_usd": 1.0
    },
    {
