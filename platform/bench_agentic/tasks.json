{
  "version": 2,
  "description": "Kubona-domain re-discovery tasks. Each task is a fixed experimental request scored against a target; the target is hidden from the executing agent. Target-from fields assert an internal invariant (measured vs the experiment's own exact anchor); constant targets are independent reference values.",
  "tasks": [
    {
      "id": "h2_vqe_ground_state",
      "description": "Reproduce the H2/STO-3G ground-state energy at 0.7414 A with a 2-layer hardware-efficient VQE.",
      "kind": "vqe",
      "spec": {
        "kind": "vqe",
        "molecule": "H2",
        "bond_distance": 0.7414,
        "layers": 2,
        "shots": 20000,
        "seed": 7,
        "max_iterations": 40
      },
      "extract": "energy",
      "target": -1.1372701746609035,
      "tolerance": 0.02,
      "chemical_accuracy": 0.0016,
      "budget_usd": 1.0
    },
    {
      "id": "h2_classical_anchor",
      "description": "Verify the exact FCI anchor used to judge the H2 task (the anchor must be a real computed value, not a template).",
