.DS_Store
__pycache__/
*.pyc
.venv/
.env
.env.*
node_modules/

# Local-only working files — never pushed
.obsidian/
dev-docs/

# platform build/test artifacts
.pytest_cache/
*.egg-info/

# Rust build artifacts
target/

# Database and runtime logs
*.db
*.db-shm
*.db-wal
*.db.lock
*.sqlite
platform/core/*.db
platform/core/*.db-shm
platform/core/*.db-wal

# Console build artifacts
platform/console/.next/
platform/console/out/
platform/console/.dart_tool/
platform/console/build/
platform/console/pubspec.lock

# Go binaries (path-anchored: a bare `kubonad` pattern once silently
# swallowed the whole platform/core/cmd/kubonad source dir, hiding
# grants.go from history since 2026-10-09 — never match source dirs again)
/kubonad
platform/core/kubonad
platform/core/bin/
