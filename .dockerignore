# Keep build contexts small and secret-free. Applies to root-context builds
# (Lean) and prevents .env / scratch material from ever reaching a builder.
.git
.gitignore
dev-docs
scratch
.obsidian
.env
.env.*
*.db
*.db-shm
*.db-wal
**/__pycache__
**/.pytest_cache
**/.venv
**/node_modules
**/.next
**/target
platform/core/bin
platform/core/kubonad
