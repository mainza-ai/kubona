# Kubona local development environment — COPY to .env and fill in.
# .env is gitignored (.env, .env.*); production takes these from the
# process environment / secret manager instead. NEVER commit secrets.

# --- LLM providers: keys enable, model IDs select -------------------------
# Model IDs live HERE (and in the UI/API), never in code. A rotation is an
# env edit + daemon restart (or an LLM Settings save), not a rebuild.
# Empty model = provider stays disabled/unresolvable with an explicit
# error naming the variable. At least one model variable (or a UI-saved
# model) is required for any LLM-backed feature to work.

# Strata local engine (current dev default — see KUBONA_LLM_PROVIDER below).
# Serving panel URL is code-defaulted; override here only if yours differs.
STRATA_MODEL=iq3_s
# STRATA_BASE_URL=http://127.0.0.1:47831/v1
# STRATA_API_KEY=   # optional; localhost needs no key unless you set one

# NVIDIA NIM (parked: configured but not the default — select explicitly
# per-role or via KUBONA_LLM_PROVIDER=nvidia when you need it).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# OpenCode hosted inference (parked: account out of funds as of 2026-10-17;
# re-enable by topping up + pointing roles at it).
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash

# Other cloud providers (all optional, all parked by default).
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local engines (enabled by default; model IDs are YOUR local filenames).
OMLX_MODEL=
OLLAMA_MODEL=
LMSTUDIO_MODEL=

# --- LLM routing -----------------------------------------------------------
# Which provider serves roles without an explicit assignment.
# Unset = strata (local dev default; production-safe, no cloud opt-in needed).
# NVIDIA stays configured above for explicit selection (parked, not default).
# KUBONA_LLM_PROVIDER=strata
# Active model override (default: the active provider's *_MODEL above).
# KUBONA_LLM_MODEL=

# Per-role overrides (provider and/or model). Role names uppercased,
# hyphens become underscores. Unset = active provider + active model.
# KUBONA_LLM_COPILOT_PROVIDER=
# KUBONA_LLM_COPILOT_MODEL=
# KUBONA_LLM_EPISTEMIC_SCRIBE_PROVIDER=
# KUBONA_LLM_EPISTEMIC_SCRIBE_MODEL=
# KUBONA_LLM_ANSATZ_SCOUT_PROVIDER=
# KUBONA_LLM_ANSATZ_SCOUT_MODEL=
# KUBONA_LLM_DISCONFIRMATION_OFFICER_PROVIDER=
# KUBONA_LLM_DISCONFIRMATION_OFFICER_MODEL=
# KUBONA_LLM_DEVICE_AUDITOR_PROVIDER=
# KUBONA_LLM_DEVICE_AUDITOR_MODEL=

# --- Production guards (only read when KUBONA_ENV=production) --------------
# KUBONA_ENV=production
# KUBONA_LLM_CLOUD=1            # explicit opt-in: non-local LLM may be called
# KUBONA_API_TOKEN=             # operator bearer for gated API writes
# KUBONA_ALLOW_PLAINTEXT=       # "1" only behind TLS-terminating proxy (compose)

# --- Cost control -----------------------------------------------------------
# KUBONA_LLM_BUDGET_USD=        # optional dollar cap on LLM spend (unset = track only)

# --- Operator keys (production: secret manager, never this file) -----------
# KUBONA_OPERATOR_PRIVKEY_HEX=  # spend-approval minting (bridge-side)
# KUBONA_REVIEWER_PRIVKEY_HEX=  # reviewer path (ephemeral dev key otherwise)
